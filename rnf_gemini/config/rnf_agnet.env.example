# RNF Gemini Agent overrides (optional)
# Copy values you need into root .env (or export before running)

# Gemini live settings
RNF_GEMINI_MODEL=models/gemini-3.1-flash-live-preview
RNF_GEMINI_VOICE=Charon
RNF_GEMINI_API_VERSION=v1alpha
RNF_GEMINI_SYSTEM_PROMPT_FILE=rnf_gemini/rnf_agnet_system_prompt.txt

# RNF KB path
RNF_RAG_KNOWLEDGE_BASE_FILE=rnf_gemini/knowledge_base/rnf_agnet_kb.txt

# Large-KB retrieval tuning
RNF_FAST_RAG_CHUNK_THRESHOLD=10
RNF_CHUNK_SIZE=300
RNF_TOP_K=6
RNF_SIMILARITY_THRESHOLD=0.22
RNF_MIN_CHUNKS=4
RNF_RAG_CHUNK_MODE=qa
RNF_RAG_CACHE_DIR=.rag_cache/rnf_agnet

# Tool payload shaping for low latency
RNF_RAG_MAX_CONTEXT_CHARS=5000
RNF_RAG_MAX_CONTEXT_CHARS_DETAIL=8000
RNF_RAG_MAX_CHUNKS=4
RNF_RAG_MAX_CHUNKS_DETAIL=6
