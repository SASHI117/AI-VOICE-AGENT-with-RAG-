# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
DAILY_ROOM_URL=  # Optional: leave empty to create a new room

# Google Gemini Live (Speech-to-Speech)
GOOGLE_API_KEY=
GEMINI_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE=Charon
GEMINI_API_VERSION=v1beta
GEMINI_SYSTEM_PROMPT_FILE=apsagent_system_prompt.txt

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
RAG_KNOWLEDGE_BASE_FILE=knowledge_base/apsagent_kb.txt
FAST_RAG_CHUNK_THRESHOLD=10
CHUNK_SIZE=300
TOP_K=6
SIMILARITY_THRESHOLD=0.22
MIN_CHUNKS=4
RAG_MAX_CONTEXT_CHARS=5000
RAG_MAX_CONTEXT_CHARS_DETAIL=7500
RAG_MAX_CHUNKS=4
RAG_MAX_CHUNKS_DETAIL=6
RAG_CHUNK_MODE=qa

SMARTFLO_API_TOKEN=
# RAG System Selection:
# - bge_m3: Local embeddings only, tuned for accuracy + speed
# - legacy: Older TieredRAG path (kept for compatibility)
RAG_BACKEND=legacy

# BGE-M3 tuning
RAG_V2_USE_FP16=false
RAG_V2_USE_SPARSE=true
RAG_V2_HYBRID_ALPHA=0.70
RAG_V2_SIMILARITY_THRESHOLD=0.10
RAG_V2_MIN_CHUNKS=3
RAG_V2_TOP_K=4
RAG_V2_CHUNK_SIZE=200
RAG_V2_CHUNK_MODE=qa_v2
RAG_V2_ENABLE_RERANKING=false
RAG_V2_RERANKING_WEIGHT=0.6
RAG_V2_ENABLE_TELUGU_PREPROCESSING=true
RAG_V2_TELUGU_NORMALIZE_VARIANTS=true
RAG_V2_ENABLE_DOMAIN_TUNING=false
RAG_V2_DOMAIN_ALPHA_CONFIDENCE_THRESHOLD=0.5

RNF_GEMINI_SYSTEM_PROMPT_FILE=rnf_gemini/rnf_agnet_system_prompt.txt
RNF_RAG_KNOWLEDGE_BASE_FILE=rnf_gemini/knowledge_base/rnf_agnet_kb.txt
RNF_RAG_CACHE_DIR=.rag_cache/rnf_agnet

CONVTASNET_TELEPHONY_STRATEGY=energy
CONVTASNET_VAD_THRESHOLD=0.001
CONVTASNET_PROFILE_LOCK_MIN_ENERGY=0
CONVTASNET_PROFILE_MIN_SIMILARITY=0
CONVTASNET_ENERGY_RATIO_DB_MIN=0
CONVTASNET_SPEECH_HOLD_CHUNKS=0
